<div class="w-full max-w-md mx-auto">
  <h1 class="text-2xl font-bold text-center mb-8"><%= t(".title") %></h1>

  <%= form_with url: login_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :username, User.human_attribute_name(:username), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :username, class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", autofocus: true %>
    </div>

    <div>
      <%= f.label :password, User.human_attribute_name(:password), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <%= f.submit t(".submit"), class: "w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 cursor-pointer" %>
  <% end %>

  <p class="text-center mt-4 text-sm text-gray-600">
    <%= t(".no_account") %><%= link_to t(".register"), register_path, class: "text-blue-600 hover:underline" %>
  </p>
</div>
