<div class="w-full max-w-md mx-auto">
  <h1 class="text-2xl font-bold text-center mb-8">注册</h1>

  <%= form_with model: @user, url: register_path, class: "space-y-4" do |f| %>
    <% if @user.errors.any? %>
      <div class="bg-red-50 border border-red-300 text-red-700 rounded-md p-3">
        <ul class="list-disc list-inside text-sm">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :username, "用户名", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :username, class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500", autofocus: true %>
    </div>

    <div>
      <%= f.label :password, "密码", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "确认密码", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <%= f.submit "注册", class: "w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 cursor-pointer" %>
  <% end %>

  <p class="text-center mt-4 text-sm text-gray-600">
    已有账号？<%= link_to "登录", login_path, class: "text-blue-600 hover:underline" %>
  </p>
</div>
