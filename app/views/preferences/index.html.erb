<section class="container mx-auto max-w-3xl px-4 py-8">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <p class="text-sm text-gray-500 mt-1 mb-6"><%= t(".subtitle") %></p>

  <div class="space-y-4">
    <% Preference::CATEGORIES.each do |category| %>
      <%= render "preferences/card", category: category, preferences: @preferences.fetch(category, []) %>
    <% end %>
  </div>
</section>
