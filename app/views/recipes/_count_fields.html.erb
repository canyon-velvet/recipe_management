<%# locals: (form:) %>
<%# All optional. A blank total is filled from prep + cook when both are given. %>
<div class="recipe-count-fields">
  <% %i[servings prep_minutes cook_minutes total_minutes].each do |field| %>
    <div class="field">
      <%= form.label field, class: "form-label" %>
      <%= form.number_field field, min: 1, step: 1, class: "form-input" %>
    </div>
  <% end %>
</div>
