<section class="container mx-auto max-w-3xl px-4 py-8">
  <!-- Top row: Title + kebab (left) • Edit (right) -->
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center">
      <h1 class="text-2xl md:text-3xl font-bold tracking-wider truncate"><%= @recipe.name %></h1>
      <div class="ml-2">
        <%= render "shared/kebab_menu", items: [
          { label: t("actions.delete"), url: recipe_path(@recipe), data: { turbo_method: :delete, turbo_confirm: t("recipes.confirm_delete") }, class: "text-red-600" }
        ] %>
      </div>
    </div>

    <%= link_to t("actions.edit"), edit_recipe_path(@recipe), class: "btn-secondary" %>
  </div>

  <!-- Tags -->
  <div class="mb-4">
    <%= render "shared/tag_badges", tags: @recipe.tags %>
  </div>

  <!-- Description -->
  <% if @recipe.description.present? %>
    <div class="mt-16">
      <%= render "shared/section_card", title: Recipe.human_attribute_name(:description), html: render_markdown(@recipe.description) %>
    </div>
  <% end %>

  <!-- Ingredients -->
  <div class="mt-16">
    <% ingredients_kv = @recipe.recipe_ingredients.map { |ri|
      label = ri.ingredient.name
      value = [ri.quantity, ri.unit].compact_blank.join(" ")
      [label, value]
    } %>
    <%= render "shared/section_card", title: t(".ingredients"), items_kv: ingredients_kv %>
  </div>

  <!-- Steps -->
  <div class="mt-16">
    <%= render "shared/section_card", title: Recipe.human_attribute_name(:steps),
          html: render("recipes/steps", steps: @recipe.steps) %>
  </div>

  <!-- Source footnote -->
  <div class="mt-4 text-left text-xs text-gray-400">
    <% if @recipe.source %>
      <%= t(".source", name: @recipe.source.name) %>
      <% if @recipe.source.url.present? %>
        · <%= link_to t(".link"), @recipe.source.url, class: "underline hover:no-underline", target: "_blank", rel: "noopener" %>
      <% end %>
    <% end %>
  </div>
</section>
