<%= render layout: "shared/inline_create_modal", locals: { title: t("recipes.form.create_source") } do %>
  <div class="field">
    <label class="form-label"><%= Source.human_attribute_name(:name) %></label>
    <input type="text" name="source[name]"
           data-inline-create-target="prefill"
           class="form-input">
  </div>

  <div class="field">
    <label class="form-label"><%= Source.human_attribute_name(:url) %></label>
    <input type="url" name="source[url]"
           class="form-input"
           placeholder="https://...">
  </div>
<% end %>
