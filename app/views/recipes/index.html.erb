<% if current_page?(root_path) %>
  <%= render "shared/hero" %>
<% else %>
  <!-- Banner -->
  <section class="w-[100vw] relative left-1/2 -translate-x-1/2 h-40 md:h-56 overflow-hidden -mt-6">
    <%= image_tag "banner.jpg", alt: t(".banner_alt"), class: "w-full h-full object-cover" %>
    <div class="absolute inset-0 bg-black/10"></div>
    <div class="absolute inset-0 flex items-center justify-start ml-8">
      <h1 class="text-white text-2xl md:text-3xl font-bold tracking-wide"><%= t(".banner_title") %></h1>
    </div>
  </section>

  <!-- Search/Filter -->
  <section class="py-6" data-controller="search-form">
    <%= form_with url: recipes_path, method: :get, data: { search_form_target: "form" }, class: "grid grid-cols-1 md:grid-cols-6 gap-4 items-end" do |f| %>
      <div class="md:col-span-2">
        <%= f.text_field :q, value: params[:q], placeholder: t(".search_placeholder"),
              data: { search_form_target: "query", action: "input->search-form#submitLater" },
              class: "form-input" %>
      </div>

      <div class="md:col-span-1">
        <%= f.select :category,
              options_for_select(Recipe.category_options, params[:category]),
              { include_blank: t(".all_categories") },
              data: { search_form_target: "category", action: "change->search-form#submitLater" },
              class: "form-select" %>
      </div>

      <div class="hidden md:block md:col-span-2"></div>

      <div class="md:col-span-1 flex md:justify-end">
        <%= link_to t(".new_recipe"), new_recipe_path, class: "btn-primary flex-shrink-0" %>
      </div>
    <% end %>
  </section>

  <!-- Recipe Cards -->
  <section class="pb-10">
    <% if @recipes.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <% @recipes.each do |recipe| %>
          <%= render "recipes/recipe_card", recipe: recipe %>
        <% end %>
      </div>
    <% else %>
      <p class="text-center text-gray-500 py-16"><%= t(".empty") %></p>
    <% end %>

    <%= render "shared/pagination", pagy: @pagy %>
  </section>
<% end %>
