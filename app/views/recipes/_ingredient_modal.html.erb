<%# locals: (aisles:) %>
<%= render layout: "shared/inline_create_modal", locals: { title: t("recipes.ingredient_fields.create") } do %>
  <div class="field">
    <label class="form-label"><%= Ingredient.human_attribute_name(:name) %></label>
    <input type="text" name="ingredient[name]"
           data-inline-create-target="prefill"
           class="form-input">
  </div>

  <div class="field">
    <label class="form-label"><%= Ingredient.human_attribute_name(:aisle) %></label>
    <select name="ingredient[aisle_id]" class="form-select">
      <option value=""><%= t("recipes.ingredient_modal.aisle_prompt") %></option>
      <% aisles.each do |aisle| %>
        <option value="<%= aisle.id %>"><%= aisle.name %></option>
      <% end %>
    </select>
  </div>
<% end %>
