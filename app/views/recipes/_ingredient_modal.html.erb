<%# locals: (ingredient_categories:) %>
<%= render layout: "shared/inline_create_modal", locals: { title: t("recipes.ingredient_fields.create") } do %>
  <div class="field">
    <label class="form-label"><%= Ingredient.human_attribute_name(:name) %></label>
    <input type="text" name="ingredient[name]"
           data-inline-create-target="prefill"
           class="form-input">
  </div>

  <div class="field">
    <label class="form-label"><%= Ingredient.human_attribute_name(:ingredient_category) %></label>
    <select name="ingredient[ingredient_category_id]" class="form-select">
      <option value=""><%= t("recipes.ingredient_modal.category_prompt") %></option>
      <% ingredient_categories.each do |cat| %>
        <option value="<%= cat.id %>"><%= cat.name %></option>
      <% end %>
    </select>
  </div>
<% end %>
