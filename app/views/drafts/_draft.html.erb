<%# locals: (draft:) %>
<div class="draft-card">
  <div class="min-w-0">
    <h3 class="font-semibold text-gray-900 truncate"><%= draft.title %></h3>
    <p class="text-sm text-gray-500 mt-1 truncate">
      <%= draft.source_host || draft.source_url || t("drafts.pasted_text") %> · <%= t(".added", time: time_ago_in_words(draft.created_at)) %>
    </p>
    <% if draft.failed? %>
      <p class="error-text mt-2"><%= t("drafts.failures.#{draft.failure_reason_key}", default: t("drafts.failures.generic")) %></p>
    <% end %>
  </div>

  <div class="flex items-center gap-2 flex-none">
    <span class="draft-status draft-status--<%= draft.status %>"><%= t("drafts.statuses.#{draft.status}") %></span>
    <%= button_to t(".discard"), draft_path(draft), method: :delete, class: "btn-cancel btn-sm",
                  form: { data: { turbo_confirm: t(".confirm_discard", title: draft.title) } } %>
  </div>
</div>
