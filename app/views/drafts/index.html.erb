<section class="container mx-auto max-w-3xl px-4 py-8">
  <div class="mb-6">
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <p class="text-sm text-gray-500 mt-1"><%= t(".subtitle") %></p>
  </div>

  <% if @drafts.any? %>
    <div class="space-y-3">
      <% @drafts.each do |draft| %>
        <%= render "drafts/draft", draft: draft %>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-gray-500 py-12"><%= t(".empty") %></p>
  <% end %>
</section>
