<%# locals: (message:, link_text: nil, href: nil) %>
<div class="toast" role="status" data-controller="toast">
  <p class="text-sm text-gray-800"><%= message %></p>
  <div class="flex items-center gap-3 flex-none">
    <% if href %>
      <%= link_to link_text, href, class: "text-sm font-medium text-sectiontext hover:underline", data: { action: "toast#dismiss" } %>
    <% end %>
    <button type="button" class="text-gray-400 hover:text-gray-600" data-action="toast#dismiss"
            aria-label="<%= t("actions.close") %>">&times;</button>
  </div>
</div>
