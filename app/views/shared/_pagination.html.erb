<%# locals: (pagy:) %>
<% if pagy.pages > 1 %>
  <nav class="flex justify-center items-center space-x-1 mt-8">
    <% if pagy.prev %>
      <%= link_to "上一页", url_for(page: pagy.prev), class: "px-3 py-2 text-sm rounded-lg border border-gray-300 hover:bg-gray-50" %>
    <% end %>

    <% pagy.series.each do |item| %>
      <% if item.is_a?(Integer) %>
        <%= link_to item, url_for(page: item), class: "px-3 py-2 text-sm rounded-lg border border-gray-300 hover:bg-gray-50" %>
      <% elsif item.is_a?(String) %>
        <span class="px-3 py-2 text-sm rounded-lg bg-indigo-600 text-white"><%= item %></span>
      <% elsif item == :gap %>
        <span class="px-2 py-2 text-sm text-gray-400">…</span>
      <% end %>
    <% end %>

    <% if pagy.next %>
      <%= link_to "下一页", url_for(page: pagy.next), class: "px-3 py-2 text-sm rounded-lg border border-gray-300 hover:bg-gray-50" %>
    <% end %>
  </nav>
<% end %>
