<div class="flex justify-center">
  <div class="relative h-[calc(100dvh-8rem)] w-auto">
    <%# The photo's size lets the browser lay out the hero before it downloads; without it the tagline,
        sized from the photo's width, briefly wraps one word per line. %>
    <%= image_tag "egg.jpg", alt: t(".image_alt"), width: 3744, height: 4565, class: "w-full h-full object-cover" %>
    <div class="absolute inset-0 bg-black/25"></div>

    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10 w-[200%] hero-tagline-box flex flex-col items-center space-y-12">
      <%# The tagline breaks at a natural phrase in each language (one locale entry per line). %>
      <p class="hero-tagline">
        <% Array(t(".tagline")).each do |line| %>
          <span class="block text-balance"><%= line %></span>
        <% end %>
      </p>
      <%= link_to t(".browse_recipes"), recipes_path, class: "bg-background font-normal hover:font-semibold text-gray-800 py-2 px-6 rounded-lg shadow-lg transition" %>
    </div>
  </div>
</div>
