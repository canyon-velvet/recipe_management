<%# locals: (title:, text: nil, items_kv: nil, html: nil) %>
<div class="rounded-xl border border-gray-200 bg-sectionbackground p-5">
  <h2 class="text-lg font-semibold text-sectiontext mb-3"><%= title %></h2>

  <% if text.present? %>
    <p class="text-sm text-gray-700 leading-relaxed"><%= text %></p>
  <% end %>

  <% if items_kv.present? %>
    <ul class="space-y-1">
      <% items_kv.each do |label, value| %>
        <li class="flex justify-between text-sm">
          <span class="text-gray-700"><%= label %></span>
          <span class="text-gray-500"><%= value %></span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if html.present? %>
    <div class="text-sm text-gray-700 leading-relaxed prose prose-sm max-w-none"><%= html %></div>
  <% end %>
</div>
