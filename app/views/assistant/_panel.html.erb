<%# locals: (conversation:, open:) %>
<%# The assistant side panel. Turbo keeps it (data-turbo-permanent) as the user moves between pages, so the chat and
    what's being typed survive navigation. Turbo matches it by id, so the id is per user: after logging in as someone
    else, the old panel is replaced. The assistant-panel controller on <body> opens and closes it. %>
<aside id="<%= assistant_panel_id %>" class="assistant-panel <%= 'hidden' unless open %>" data-turbo-permanent
       data-assistant-panel-target="panel" aria-label="<%= t("assistant.title") %>">
  <div class="assistant-header">
    <h2 class="assistant-title"><span aria-hidden="true">✦</span> <%= t("assistant.title") %></h2>
    <div class="flex items-center gap-1">
      <%= button_to t("assistant.new_chat"), assistant_conversations_path, class: "assistant-header-button",
                    form: { data: { turbo_stream: true } } %>
      <button type="button" class="assistant-header-button" data-action="assistant-panel#close"
              aria-label="<%= t("assistant.close") %>">×</button>
    </div>
  </div>

  <%= render "assistant/conversations/messages", conversation: conversation %>
  <%= render "assistant/messages/form" %>
</aside>
