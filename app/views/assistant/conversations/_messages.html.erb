<%# locals: (conversation:) %>
<%# The chat so far: its latest messages, so every page renders the same small panel however long the chat gets.
    The hint shows only while it's empty (CSS hides it once a message is added). %>
<div id="assistant_messages" class="assistant-messages" data-assistant-panel-target="messages" aria-live="polite">
  <p class="assistant-empty"><%= t("assistant.empty") %></p>
  <% if conversation %>
    <%= render partial: "assistant/messages/message", collection: conversation.recent_messages(50), as: :message %>
  <% end %>
</div>
