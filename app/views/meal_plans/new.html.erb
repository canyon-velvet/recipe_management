<section class="container mx-auto max-w-md px-4 py-8">
  <h1 class="text-2xl font-bold mb-6"><%= t(".title") %></h1>

  <%= form_with model: @meal_plan, class: "space-y-6" do |f| %>
    <% if @meal_plan.errors.any? %>
      <div class="bg-red-50 border border-red-300 text-red-700 rounded-md p-3">
        <ul class="list-disc list-inside text-sm">
          <% @meal_plan.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :name, t(".name"), class: "form-label" %>
      <%= f.text_field :name, class: "form-input", placeholder: t(".name_placeholder") %>
    </div>

    <div class="field" data-controller="week-picker">
      <%= f.label :start_date, t(".week"), class: "form-label" %>
      <%= f.date_field :start_date, class: "form-input",
            data: { week_picker_target: "input", action: "change->week-picker#snap" } %>
      <p class="help-text"><%= t(".week_help") %></p>
    </div>

    <div class="flex items-center gap-3 pt-4">
      <%= f.submit t(".create"), class: "btn-primary" %>
      <%= link_to t("actions.cancel"), meal_plans_path, class: "btn-cancel" %>
    </div>
  <% end %>
</section>
