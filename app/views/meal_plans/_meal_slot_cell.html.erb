<%# locals: (meal_slot:) %>
<div class="meal-slot-cell">
  <% meal_slot.meal_slot_recipes.each do |msr| %>
    <div class="flex items-center gap-1 rounded px-1 py-0.5 <%= 'bg-green-50' if msr.add_to_grocery_list %>">
      <!-- Grocery checkbox -->
      <input type="checkbox"
             class="rounded border-gray-300 text-green-600 focus:ring-green-500 shrink-0"
             <%= "checked" if msr.add_to_grocery_list %>
             data-action="change->recipe-select#toggleGrocery"
             data-url="<%= meal_slot_recipe_path(msr) %>">

      <!-- Recipe name -->
      <span class="slot-recipe-name flex-1"><%= msr.recipe.name %></span>

      <!-- Kebab actions -->
      <div class="shrink-0 relative" data-controller="dropdown">
        <button type="button" data-action="dropdown#toggle click@window->dropdown#close" class="text-gray-400 hover:text-gray-600 p-0.5">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 6a2 2 0 110-4 2 2 0 010 4zm0 6a2 2 0 110-4 2 2 0 010 4zm0 6a2 2 0 110-4 2 2 0 010 4z"/>
          </svg>
        </button>
        <div data-dropdown-target="menu" class="hidden absolute right-0 z-20 mt-1 w-28 rounded-lg border border-gray-200 bg-white shadow-lg py-1">
          <%= link_to "浏览菜谱", recipe_path(msr.recipe), class: "block px-3 py-1.5 text-xs text-gray-700 hover:bg-gray-50" %>
          <%= button_to "移出计划", meal_slot_recipe_path(msr),
                method: :delete,
                class: "block w-full text-left px-3 py-1.5 text-xs text-red-600 hover:bg-gray-50",
                form: { data: { turbo_stream: true } } %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Always show add button -->
  <div class="flex items-center justify-center pt-1">
    <button type="button"
            class="slot-add-btn"
            data-action="recipe-select#openForSlot"
            data-meal-slot-id="<%= meal_slot.id %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
    </button>
  </div>
</div>
